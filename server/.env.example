# Copy this file to ".env" (same folder) and fill in your real values.
# The real .env file is ignored by git, so it never goes to GitHub.

# Port the server runs on (Render sets this automatically)
PORT=5000

# MongoDB Atlas connection link (Atlas → Connect → Drivers)
MONGO_URI=

# A long random secret used to sign admin login tokens. Create one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Website(s) allowed to call this API, separated by commas
CLIENT_URL=http://localhost:5173

# Cloudinary, for menu photo uploads (cloudinary.com → Dashboard → API Keys).
# The server runs without these; only photo upload is turned off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only needed once, for "npm run create-admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email to the owner when a new order arrives, sent with Resend (resend.com, free plan).
# The server runs without these; only the email is turned off.
# RESEND_API_KEY: resend.com → API Keys → Create API key (starts with "re_")
RESEND_API_KEY=
# Who gets the email. With Resend's free test sender this MUST be the email you signed up to Resend with.
ORDER_EMAIL_TO=
# Optional. Leave empty to use Resend's test sender (onboarding@resend.dev).
# Only change it after verifying your own domain in Resend, e.g. "Whisk & Co." <orders@yourdomain.com>
ORDER_EMAIL_FROM=
