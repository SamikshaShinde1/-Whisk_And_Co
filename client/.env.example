# Copy this file to ".env" (same folder) and fill in your real values.
# The real .env file is ignored by git, so it never goes to GitHub.

# Where the backend runs. Locally: http://localhost:5000  (after deploying: your Render URL)
VITE_API_URL=http://localhost:5000

# Your WhatsApp number: country code + number, digits only, e.g. 91XXXXXXXXXX
VITE_WHATSAPP_NUMBER=

# The website's own address, used for link previews on WhatsApp/Instagram.
# Locally: http://localhost:5173  (after deploying: your Vercel URL, e.g. https://whisk-and-co.vercel.app)
VITE_SITE_URL=http://localhost:5173
